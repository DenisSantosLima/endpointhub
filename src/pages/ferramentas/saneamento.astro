---
import Base from '../../layouts/Base.astro';
import DashboardSaneamento from '../../components/DashboardSaneamento.jsx';
---
<Base titulo="Saneamento de bases" wide={true} descricao="Cruze Intune, Defender, Entra e inventário para sanear a gestão de endpoints. Upload local, sem envio de dados.">
  <!--
    O dashboard é um componente React com estado e upload de arquivos.
    client:only="react" o hidrata só aqui, no navegador — o resto do site
    permanece HTML estático sem JavaScript. Como ele processa uploads do
    usuário (sem SSR), client:only evita renderização no servidor.
  -->
  <DashboardSaneamento client:only="react" lang="pt" />
</Base>
