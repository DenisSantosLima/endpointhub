---
import '../styles/global.css';
import { useTranslations, langFromUrl, localizedPath, LANGS, LANG_LABEL } from '../i18n';
import Search from '../components/Search.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

export interface Props {
  titulo: string;
  descricao?: string;
  wide?: boolean;
}
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const { titulo, descricao = t('home.lead'), wide = false } = Astro.props;

const nav = [
  { key: 'nav.inicio', path: '/' },
  { key: 'nav.ferramentas', path: '/ferramentas' },
  { key: 'nav.artigos', path: '/artigos' },
] as const;

const bare = Astro.url.pathname.replace(/^\/(en|es)(?=\/|$)/, '') || '/';
const path = Astro.url.pathname;
const isActive = (p) => {
  const target = localizedPath(p, lang);
  return path === target || (p !== '/' && path.startsWith(target));
};
---
<!DOCTYPE html>
<html lang={lang === 'pt' ? 'pt-BR' : lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo} · EndpointHub</title>
  <meta name="description" content={descricao} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  {LANGS.map((l) => (
    <link rel="alternate" hreflang={l === 'pt' ? 'pt-BR' : l} href={localizedPath(bare, l)} />
  ))}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    // Aplica o tema salvo antes da pintura, evitando flash de cor.
    (function () {
      try {
        var t = localStorage.getItem('eh-theme');
        if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class={wide ? 'container wide' : 'container'}>
      <div class="bar">
        <a class="brand" href={localizedPath('/', lang)}><span class="dot"></span>EndpointHub</a>
        <nav class="nav">
          {nav.map((n) => (
            <a href={localizedPath(n.path, lang)} class={isActive(n.path) ? 'active' : ''}>{t(n.key)}</a>
          ))}
          <Search lang={lang} />
          <ThemeToggle />
          <span class="lang-switch">
            {LANGS.map((l, i) => (
              <>
                {i > 0 && <span class="lang-sep">·</span>}
                <a href={localizedPath(bare, l)} class={l === lang ? 'lang active' : 'lang'} aria-label={LANG_LABEL[l]}>{LANG_LABEL[l]}</a>
              </>
            ))}
          </span>
        </nav>
      </div>
    </div>
  </header>

  <main class={wide ? 'container wide' : 'container'} style="padding-top: 32px;">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="row">
        <span>{t('footer.tagline')}</span>
        <span style="margin-left:auto;">{t('footer.privacy')}</span>
      </div>
    </div>
  </footer>
</body>
</html>
