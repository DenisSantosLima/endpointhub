---
import { getCollection } from 'astro:content';
import { useTranslations, langFromUrl, localizedPath } from '../../i18n';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const artigos = (await getCollection('artigos', ({ data }) => !data.rascunho && data.lang === lang))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
const categorias = [t('articles.all'), 'Como fazer', 'Troubleshooting', 'Hardening', 'PowerShell / Graph'];
const locale = lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US';
const fmt = (d) => new Intl.DateTimeFormat(locale, { day: '2-digit', month: 'short', year: 'numeric' }).format(d);
---
<p class="eyebrow">{t('articles.eyebrow')}</p>
<h1>{t('articles.h1')}</h1>
<p class="lead">{t('articles.lead')}</p>
<div style="display:flex; gap:8px; flex-wrap:wrap; margin:22px 0;">
  {categorias.map((c, i) => (
    <button class="tag" data-cat={i === 0 ? '__all__' : c} style="cursor:pointer; padding:6px 12px; font-size:12.5px;">{c}</button>
  ))}
</div>
<div class="grid cols-2" id="lista">
  {artigos.map((a) => (
    <a class="card artigo" href={localizedPath(`/artigos/${a.data.slug}`, lang)} data-cat={a.data.categoria}>
      <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <span class="tag">{a.data.categoria}</span>
        <span class="badge" style="border:none; background:none; color:var(--faint);">{a.data.nivel}</span>
      </div>
      <strong style="display:block; font-size:16px; margin:10px 0 6px;">{a.data.titulo}</strong>
      <p style="color:var(--dim); font-size:14px; margin:0 0 12px;">{a.data.resumo}</p>
      <div class="meta-row"><span>{a.data.autor}</span><span>·</span><span>{fmt(a.data.data)}</span></div>
    </a>
  ))}
</div>
{artigos.length === 0 && <p style="color:var(--faint); margin-top:24px;">{t('articles.empty')}</p>}
<script is:inline>
  const cards = document.querySelectorAll('.artigo');
  document.querySelectorAll('button[data-cat]').forEach((b) => {
    b.addEventListener('click', () => {
      const cat = b.getAttribute('data-cat');
      cards.forEach((c) => { c.style.display = (cat === '__all__' || c.getAttribute('data-cat') === cat) ? '' : 'none'; });
    });
  });
</script>
