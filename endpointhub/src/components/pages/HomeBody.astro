---
import { getCollection } from 'astro:content';
import { useTranslations, langFromUrl, localizedPath } from '../../i18n';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const artigos = (await getCollection('artigos', ({ data }) => !data.rascunho && data.lang === lang))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf()).slice(0, 6);
const ferramentas = [
  { path: '/ferramentas/saneamento', nome: 't.saneamento.nome', desc: 't.saneamento.desc', estado: 'ready' },
  { path: '/ferramentas/analytics', nome: 't.analytics.nome', desc: 't.analytics.desc', estado: 'ready' },
  { path: '/ferramentas', nome: 't.cobertura.nome', desc: 't.cobertura.desc', estado: 'soon' },
  { path: '/ferramentas', nome: 't.duplicatas.nome', desc: 't.duplicatas.desc', estado: 'soon' },
];
const locale = lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US';
const fmt = (d) => new Intl.DateTimeFormat(locale, { day: '2-digit', month: 'short' }).format(d);
---
<section style="padding: 24px 0 20px;">
  <p class="eyebrow">{t('home.eyebrow')}</p>
  <h1 style="max-width: 20ch;">{t('home.h1')}</h1>
  <p class="lead">{t('home.lead')}</p>
</section>

<div class="home-cols">
  <!-- Coluna ferramentas -->
  <div>
    <div class="col-head">
      <h2 style="margin:0; font-size:18px;">{t('home.tools')}</h2>
      <a href={localizedPath('/ferramentas', lang)} class="col-link">{t('home.cta.tools')} →</a>
    </div>
    <div style="display:flex; flex-direction:column; gap:10px;">
      {ferramentas.map((f) => (
        <a class="card" href={f.estado === 'ready' ? localizedPath(f.path, lang) : localizedPath('/ferramentas', lang)}>
          <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
            <strong style="font-size:14.5px;">{t(f.nome)}</strong>
            <span class={f.estado === 'ready' ? 'badge pill-ready' : 'badge pill-soon'}>{f.estado === 'ready' ? t('tools.ready') : t('tools.soon')}</span>
          </div>
          <p style="color:var(--dim); font-size:13px; margin:6px 0 0;">{t(f.desc)}</p>
        </a>
      ))}
    </div>
  </div>

  <!-- Coluna artigos -->
  <div>
    <div class="col-head">
      <h2 style="margin:0; font-size:18px;">{t('home.latest')}</h2>
      <a href={localizedPath('/artigos', lang)} class="col-link">{t('home.cta.articles')} →</a>
    </div>
    <div class="card" style="padding:4px 16px;">
      {artigos.map((a, i) => (
        <a href={localizedPath(`/artigos/${a.data.slug}`, lang)} class="feed-item" style={i === artigos.length - 1 ? 'border-bottom:none;' : ''}>
          <span class="feed-date">{fmt(a.data.data)}</span>
          <span>
            <span class="feed-title">{a.data.titulo}</span>
            <span class="feed-meta">{a.data.categoria} · {a.data.nivel}</span>
          </span>
        </a>
      ))}
      {artigos.length === 0 && <p style="color:var(--faint); font-size:13px; padding:12px 0;">{t('articles.empty')}</p>}
    </div>
  </div>
</div>
