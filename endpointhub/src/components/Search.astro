---
// Busca no cabeçalho. Ícone que abre um modal; filtra o índice de artigos
// (título, resumo, tags, categoria) no idioma atual. Tudo client-side.
import { useTranslations, type Lang } from '../i18n';
export interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const ph = { pt: 'Buscar artigos…', en: 'Search articles…', es: 'Buscar artículos…' }[lang];
const empty = { pt: 'Nenhum artigo encontrado.', en: 'No articles found.', es: 'Ningún artículo encontrado.' }[lang];
const hint = { pt: 'Digite para buscar por título, resumo, tag ou categoria.', en: 'Type to search by title, summary, tag or category.', es: 'Escribe para buscar por título, resumen, etiqueta o categoría.' }[lang];
const base = lang === 'pt' ? '' : `/${lang}`;
---
<button id="search-open" class="search-btn" aria-label={ph}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
</button>

<div id="search-modal" class="search-modal" hidden>
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-box" role="dialog" aria-modal="true">
    <div class="search-inputwrap">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--faint)"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input id="search-input" type="text" placeholder={ph} autocomplete="off" />
      <kbd class="search-esc">ESC</kbd>
    </div>
    <div id="search-results" class="search-results"></div>
    <div id="search-hint" class="search-hint">{hint}</div>
  </div>
</div>

<script define:vars={{ lang, base, empty }}>
  const openBtn = document.getElementById('search-open');
  const modal = document.getElementById('search-modal');
  // Move o modal para o <body> para escapar do stacking context do header sticky,
  // que prende o position:fixed dentro do cabeçalho.
  if (modal && modal.parentElement !== document.body) document.body.appendChild(modal);
  const backdrop = document.getElementById('search-backdrop');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const hint = document.getElementById('search-hint');
  let index = null;

  async function ensureIndex() {
    if (index) return index;
    try {
      const res = await fetch(`${base}/search-index.json`);
      const all = await res.json();
      index = all.filter((a) => a.lang === lang);
    } catch { index = []; }
    return index;
  }

  function open() {
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    ensureIndex().then(() => { input.focus(); render(''); });
  }
  function close() {
    modal.hidden = true;
    document.body.style.overflow = '';
    input.value = '';
    results.innerHTML = '';
  }

  async function render(q) {
    await ensureIndex();
    q = q.trim().toLowerCase();
    hint.style.display = q ? 'none' : 'block';
    if (!q) { results.innerHTML = ''; return; }
    const hits = (index || []).filter((a) => {
      const hay = [a.titulo, a.resumo, a.categoria, (a.tags || []).join(' ')].join(' ').toLowerCase();
      return q.split(/\s+/).every((term) => hay.includes(term));
    }).slice(0, 12);
    if (!hits.length) { results.innerHTML = `<div class="search-empty">${empty}</div>`; return; }
    results.innerHTML = hits.map((a) => `
      <a class="search-hit" href="${base}/artigos/${a.slug}">
        <div class="search-hit-cat">${a.categoria} · ${a.nivel}</div>
        <div class="search-hit-title">${a.titulo}</div>
        <div class="search-hit-sum">${a.resumo}</div>
      </a>`).join('');
  }

  openBtn?.addEventListener('click', open);
  backdrop?.addEventListener('click', close);
  input?.addEventListener('input', (e) => render(e.target.value));
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); modal.hidden ? open() : close(); }
    if (e.key === 'Escape' && !modal.hidden) close();
  });
</script>
